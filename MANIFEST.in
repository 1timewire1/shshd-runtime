# Publish authored code and specifications only. Original game files,
# native decompilations, generated traces, libraries and saves stay local.
global-exclude *
include LICENSE README.md AGENTS.md pyproject.toml uv.lock MANIFEST.in .gitignore
include RELEASE.md CHANGELOG.md MAINTAINERS.md
include packages/*/pyproject.toml packages/*/MANIFEST.in packages/*/LICENSE packages/*/README.md
recursive-include packages/formats/src/exp_runtime *.py
recursive-include packages/engine/src/exp_runtime *.py
recursive-include packages/player/src/exp_runtime *.py
recursive-include packages/shs/src/exp_runtime *.py
recursive-include packages/cod/src/exp_runtime *.py
recursive-include packages/creator/src/exp_runtime *.py
include packages/player/src/exp_runtime/assets/kiwi.svg
include packages/creator/src/exp_runtime/creator/kiwi-hammer.svg
recursive-include tests test_*.py
include docs/SCHEMA.md docs/VM_SPEC.md
include docs/DISTRIBUTION.md docs/DEVELOPMENT.md docs/PROVENANCE.md
include docs/ENGINE_ABI.md docs/RUNTIME.md docs/VM_EXECUTION.md
include docs/UI_FIDELITY.md docs/UI_ASSETS.md docs/MINIGAMES.md
include docs/GRID_UI.md
include docs/SDK.md
include docs/CREATOR.md docs/MCP.md
include docs/images/creator/story-graph.png
include docs/images/creator/debugger.png
include docs/images/creator/translations.png
include docs/FOOTBALL_UI.md
include docs/TITLE_SCREENS.md
include docs/NAME_INPUT.md
include docs/IPA.md
include docs/COD.md
include docs/MAIN_MENU.md docs/STORY_SERVICES.md docs/EPISODE_CATALOG.md
include tools/build_desktop.py tools/audit_format.py tools/audit_vm.py
include tools/components.py tools/build_packages.py tools/test_packages.py
include tools/test_creator_native.py
include tools/audit_runtime.py tools/audit_ui_assets.py
include tools/package_desktop.py
include tools/build_rar.py
include .github/workflows/desktop-builds.yml
include .github/workflows/ios-builds.yml
include docs/IOS_APP.md
include tools/build_ios.py tools/package_ios.py tools/test_ios.py
include ios/dependencies.json ios/EXPRuntime.xcodeproj/project.pbxproj
include ios/Signing.xcconfig ios/Signing.local.xcconfig.example
include ios/EXPRuntime/EXPRuntimeApp.swift ios/EXPRuntime/PythonBridge.h
include ios/EXPRuntime/PythonBridge.m ios/EXPRuntime/Info.plist
include ios/EXPRuntime/NativeCanvas.swift ios/EXPRuntime/NativeFonts.h ios/EXPRuntime/NativeFonts.m
include ios/probe/exp_ios_probe.py
include ios/probe/rar_fixture.py
